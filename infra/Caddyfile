# 주소 하나 (07 문서 4절, 10 문서 결정 23): 화면 파일 + /api → API 서버. https 인증서는 Caddy가 자동으로 받는다.
{$SITE_ADDRESS} {
	encode gzip

	# /api 를 떼고 API 서버로 넘긴다 (WebSocket 링크 통화 포함)
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# 화면 파일. 없는 주소(/c/통화번호 등)는 index.html 로 (앱이 알아서 화면을 고른다)
	handle {
		root * /srv/web
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# 마이크는 이 사이트에서만 (청인 말 자막)
		Permissions-Policy "microphone=(self), camera=()"
		-Server
	}

	# 접속 기록에 글 내용이 남지 않도록 Caddy 접속 기록은 켜지 않는다 (07 문서 7절)
}
