# 복사해서 .env 로 이름을 바꿔 쓰세요. (.env 는 Git에 올라가지 않아요)
# 07_기술구조_API.md 9절 기준. 아래 값은 내 컴퓨터 개발용 예시예요.
APP_SECRET=change-me
DATABASE_URL=sqlite+aiosqlite:///./data/itda.db
AUDIO_DIR=./data/audio
VOICES_JSON=../tts/voices.json
CONSENT_VERSION=event-2026-11-v1
SIGNUP_LIMIT_PER_MIN=30
ALLOWED_ORIGIN=http://localhost:5173
# 개발 중에는 웹앱의 /api 연결(Vite proxy)을 거쳐 받는다. 배포 때는 https://api.itda.gyeot.ai.kr/a
PUBLIC_AUDIO_BASE=/api/a
TTS_LIMIT_PER_MIN=20
TTS_ENDPOINTS=
TTS_KEY=change-me
TTS_MAX_CONCURRENCY=4
TTS_START_TIMEOUT_MS=2500
TTS_TOTAL_TIMEOUT_MS=4000
EMOTION_LLM_ENABLED=false
EMOTION_LLM_API_KEY=
STT_SERVER_ENABLED=false
