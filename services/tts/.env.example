# 복사해서 .env 로 이름을 바꿔 쓰세요. (.env 는 Git에 올라가지 않아요)
# API 서버의 TTS_KEY 와 같은 값이어야 해요. 비어 있으면 서버가 시작되지 않아요.
TTS_KEY=change-me
# 방식 A (10/24 결정): 만들어 둔 기준 음성을 복제하는 Base 1.7B
TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# build_voices.py 가 만든 목소리 폴더 ({id}/meta.json, {id}/{감정}.wav)
TTS_VOICES_DIR=/workspace/voices
TTS_LANGUAGE=Korean
# auto: RTX 30·40 계열은 bfloat16, 무료 GPU(T4)는 float16
TTS_DTYPE=auto
TTS_ATTN=sdpa
